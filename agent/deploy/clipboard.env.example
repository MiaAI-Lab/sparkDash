# ~/.config/sparkdash-agent/clipboard.env. The dashboard's address; when the
# dashboard has a SPARKDASH_TOKEN, put it in ~/.config/sparkdash-agent/token (mode 600).
# --device names this desktop in the clipboard history (default: the hostname).
SPARKDASH_CLIPBOARD_ARGS=--dashboard http://192.0.2.20:5555
# SPARKDASH_CLIPBOARD_ARGS=--dashboard https://dashboard.example.ts.net --device laptop
