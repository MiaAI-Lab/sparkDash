# /etc/sparkdash-agent/agent.env. Bind this host's LAN address (never
# 0.0.0.0) and let only the dashboard's network connect.
SPARKDASH_AGENT_ARGS=--listen 192.0.2.10:9110 --allow 192.0.2.0/24
# Several listeners and ranges are fine. An address that is not up yet (e.g. a
# tailnet IP before tailscaled starts) is retried every 5 s; tailnet peers come
# from 100.64.0.0/10:
# SPARKDASH_AGENT_ARGS=--listen 192.0.2.10:9110 --listen 198.51.100.10:9110 --allow 192.0.2.0/24 --allow 100.64.0.0/10
