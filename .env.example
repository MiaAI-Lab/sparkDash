PORT=5555
# Listen address. Non-loopback startup fails closed because this release does not
# authenticate direct LAN clients. Keep loopback and use docs/REMOTE-ACCESS.md.
BIND_HOST=127.0.0.1
# Tokenless remote bind. Default is 1; set 0 to fail closed without SPARKDASH_TOKEN.
SPARKDASH_ALLOW_OPEN_REMOTE=1
# Self-update notice: compares the running version with upstream main's package.json.
# Set to off for an air-gapped install (no outbound request).
# SPARKDASH_UPDATE_CHECK=off
LLM_PORT=8888
# Optional sanitized inference activity (disabled unless a URL is supplied).
# URL must use an explicit loopback/RFC1918 IP literal, with no credentials/query.
# Labels are approved non-secret display names, NOT API keys. No source auth is sent.
# SPARKDASH_INFERENCE_ACTIVITY_URL=http://127.0.0.1:9001/activity
# SPARKDASH_INFERENCE_ACTIVITY_LABELS=service-a,user-1
# Collector cadence follows Settings -> Poll interval. Setting one of these in the
# server's environment pins that domain instead (an explicitly set value wins).
# POLL_INTERVAL_GPU=2000
# POLL_INTERVAL_CPU=2000
# POLL_INTERVAL_NETWORK=2000
# POLL_INTERVAL_LLM=2000
# POLL_INTERVAL_BANDWIDTH=2000
POLL_INTERVAL_STORAGE=5000
# Optional: ssh -i path inside the container when the key is not a default OpenSSH name.
# The mounted private key must be mode 600 on the host.
# SSH_IDENTITY_FILE=/root/.ssh/id_ed25519
# Reuse authenticated SSH transports for remote polling. Set to 0 to disable.
SSH_CONTROL_PERSIST_SECONDS=60
# Benchmarks allowed to run at once across the fleet (1-32). Each unit still runs one at a time.
# MAX_ACTIVE_BENCH_JOBS=2
# One-off Remote benchmark hosts (Decode / Prefill / Quality "Remote" target) must be listed here, comma separated.
# SPARKDASH_BENCH_HOSTS=my-box.tailnet.ts.net
# Harness occupancy helpers. Loopback is always allowed. Add other helper hostnames here.
# SPARKDASH_HELPER_HOSTS=mac.tailnet.ts.net
# OCCUPANCY_POLL_MS=15000
# Cost compare: opt-in daily refresh of the hosted-model price catalog from
# raw.githubusercontent.com (community litellm list). While 0, the page serves
# the last catalog persisted at MODEL_PRICES_JSON_PATH and makes no requests.
# MODEL_PRICES_FETCH=1
# Password for the MQTT broker configured in Settings → MQTT (the URL and username
# live in settings.json). Publishing is opt-in and does nothing until enabled.
# SPARKDASH_MQTT_PASSWORD=hunter2
