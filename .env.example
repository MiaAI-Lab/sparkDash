PORT=5555
# Listen address. Non-loopback startup fails closed because this release does not
# authenticate direct LAN clients. Keep loopback and use docs/REMOTE-ACCESS.md.
BIND_HOST=127.0.0.1
# Tokenless remote bind. Default is 1; set 0 to fail closed without SPARKDASH_TOKEN.
SPARKDASH_ALLOW_OPEN_REMOTE=1
LLM_PORT=8888
POLL_INTERVAL_GPU=2000
POLL_INTERVAL_CPU=2000
POLL_INTERVAL_NETWORK=2000
POLL_INTERVAL_STORAGE=5000
POLL_INTERVAL_LLM=2000
POLL_INTERVAL_BANDWIDTH=1000
# Optional: ssh -i path inside the container when the key is not a default OpenSSH name.
# The mounted private key must be mode 600 on the host.
# SSH_IDENTITY_FILE=/root/.ssh/id_ed25519
# Reuse authenticated SSH transports for remote polling. Set to 0 to disable.
SSH_CONTROL_PERSIST_SECONDS=60

# ── Multi-Spark dashboard: node registry ─────────────────────────────────────
# Where the dashboard reads its node registry (server/fleet/registry.js).
# In-container the mount puts it at /app/config/nodes.json.
# NODES_JSON_PATH=/app/config/nodes.json

# ── Node agent (per-Spark service) ────────────────────────────────────────────
# HTTP port + bind for the node agent's local API (agent/main.js).
NODE_AGENT_PORT=30091
NODE_AGENT_BIND=0.0.0.0
# Recipe catalog path (per-node services: model/engine/image/footprint).
# In-container default: /app/agent/config/recipes.json.
RECIPES_PATH=/app/agent/config/recipes.json
# Optional bearer token for the node agent HTTP API (send Bearer <token>).
# NODE_AGENT_TOKEN=
# Optional node identity; defaults to hostname when unset.
# NODE_ID=
# NODE_NAME=
# LLM server ports to probe for live versions/requests (comma-separated).
# LLM_PORTS=8080
# ComfyUI port; 0 disables the probe.
# NODE_COMFY_PORT=8188
