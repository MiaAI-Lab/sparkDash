[Unit]
Description=glm-tap — request tap in front of a vLLM/OpenAI-compatible engine (:8888 → :8889 relay, JSON on :8890)
After=network-online.target
Wants=network-online.target

[Service]
User=sysadmin
ExecStart=/usr/bin/python3 /opt/glm-tap/glm-tap.py
# TAP_UPSTREAM_PORT (engine, default 8888) · TAP_LISTEN_PORT (relay, 8889) · TAP_API_PORT (JSON, 8890)
# Route external clients through the relay only while it runs. Edit the interface list for your host
# (LAN NIC, tailscale0, ...). Loopback and any interface not listed are untouched; if the tap dies the
# rules go with it (ExecStopPost) and clients reach the engine directly.
ExecStartPost=/bin/sh -c 'sleep 1; for i in ${TAP_IFACES:-eth0}; do iptables -t nat -C PREROUTING -i $i -p tcp --dport 8888 -j REDIRECT --to-ports 8889 2>/dev/null || iptables -t nat -I PREROUTING 1 -i $i -p tcp --dport 8888 -j REDIRECT --to-ports 8889; done'
# Stop = drop the redirect first (new clients go straight to the engine), then ask the tap to drain: it stops
# accepting, finishes relaying every stream in flight (up to TAP_DRAIN_MAX_S, default 900 s) and exits.
# A restart therefore never cuts a conversation; requests that start during the drain are simply untapped.
ExecStop=/bin/sh -c 'for i in ${TAP_IFACES:-eth0}; do while iptables -t nat -D PREROUTING -i $i -p tcp --dport 8888 -j REDIRECT --to-ports 8889 2>/dev/null; do :; done; done; kill -TERM $MAINPID'
ExecStopPost=/bin/sh -c 'for i in ${TAP_IFACES:-eth0}; do while iptables -t nat -D PREROUTING -i $i -p tcp --dport 8888 -j REDIRECT --to-ports 8889 2>/dev/null; do :; done; done'
TimeoutStopSec=960
PermissionsStartOnly=true
Restart=always
RestartSec=2
Environment=TAP_PREVIEW_CHARS=600
Environment=TAP_IFACES="eth0 tailscale0"

[Install]
WantedBy=multi-user.target
