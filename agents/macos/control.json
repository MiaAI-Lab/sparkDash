{
  "schema": "sparkdash.mac-control/1",
  "source": "Launch commands mirror model-start / model-stop on the captain's Mac (MK-MacBook-Pro-5). The agent does not bake those engine names into code; edit this catalog to retarget a machine.",
  "notes": [
    "GET /control and the serving probe never execute these commands.",
    "POST /control/start and POST /control/stop run the matching argv only after SPARKDASH_MAC_CONTROL_TOKEN matches.",
    "The privileged root collector refuses control even if this file is present.",
    "A request names a catalog entry. It is not interpolated into the command."
  ],
  "targets": [
    {
      "name": "omlx",
      "label": "oMLX",
      "group": "omlx",
      "groupLabel": "oMLX",
      "models": [{ "id": "default", "label": "start-command default" }],
      "start": ["/bin/zsh", "-c", "source \"$HOME/.zshrc\" && model-start omlx"],
      "stop": ["/bin/zsh", "-c", "source \"$HOME/.zshrc\" && model-stop omlx"]
    },
